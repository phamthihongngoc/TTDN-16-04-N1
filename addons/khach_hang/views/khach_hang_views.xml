<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Form View -->
    <record id="view_khach_hang_form" model="ir.ui.view">
        <field name="name">khach_hang.form</field>
        <field name="model">khach_hang</field>
        <field name="arch" type="xml">
            <form string="Khách hàng">
                <header>
                    <button name="action_chuyen_trang_thai_giao_dich" string="Chuyển sang Đang giao dịch" 
                            type="object" class="oe_highlight" 
                            attrs="{'invisible': [('trang_thai', '!=', 'moi')]}"/>
                    <button name="action_gui_email" string="Gửi Email" type="object" icon="fa-envelope"/>
                    <field name="trang_thai" widget="statusbar" statusbar_visible="moi,dang_giao_dich,cu"/>
                </header>
                <sheet>
                    <!-- SMART BUTTONS - Enhanced -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_don_hang"
                                icon="fa-shopping-cart">
                            <div class="o_stat_info">
                                <field name="don_hang_count" class="o_stat_value"/>
                                <span class="o_stat_text">Đơn hàng</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_hoa_don"
                                icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <field name="hoa_don_count" class="o_stat_value"/>
                                <span class="o_stat_text">Hóa đơn</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_ho_tro"
                                icon="fa-headphones">
                            <div class="o_stat_info">
                                <field name="ho_tro_count" class="o_stat_value"/>
                                <span class="o_stat_text">Hỗ trợ</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_emails"
                                icon="fa-envelope">
                            <div class="o_stat_info">
                                <field name="email_count" class="o_stat_value"/>
                                <span class="o_stat_text">Email</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_van_ban"
                                icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value" style="font-size: 16px;">📄</span>
                                <span class="o_stat_text">Văn bản</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_yeu_cau_ky">
                            <div class="o_stat_info">
                                <field name="yeu_cau_ky_count" class="o_stat_value"/>
                                <span class="o_stat_text">Yêu cầu ký</span>
                            </div>
                        </button>
                    </div>
                    
                    <!-- RFM Segment Badge -->
                    <widget name="web_ribbon" title="VIP ⭐" bg_color="bg-success"
                            attrs="{'invisible': [('rfm_segment', '!=', 'vip')]}"/>
                    <widget name="web_ribbon" title="Loyal 💚" bg_color="bg-info"
                            attrs="{'invisible': [('rfm_segment', '!=', 'loyal')]}"/>
                    <widget name="web_ribbon" title="At Risk ⚠️" bg_color="bg-warning"
                            attrs="{'invisible': [('rfm_segment', '!=', 'at_risk')]}"/>
                    <widget name="web_ribbon" title="Lost 🚨" bg_color="bg-danger"
                            attrs="{'invisible': [('rfm_segment', '!=', 'lost')]}"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="ten_khach_hang" placeholder="Tên khách hàng..."/>
                        </h1>
                        <h3>
                            <field name="cong_ty" placeholder="Tên công ty (nếu có)..."/>
                        </h3>
                    </div>
                    
                    <group>
                        <group string="Thông tin liên hệ">
                            <field name="so_dien_thoai" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="dia_chi" placeholder="Địa chỉ chi tiết..."/>
                        </group>
                        <group string="Phân loại &amp; Quản lý">
                            <field name="phan_loai" widget="badge"/>
                            <field name="nhan_vien_phu_trach_id"/>
                            <field name="ten_nhan_vien_phu_trach" readonly="1" attrs="{'invisible': [('ten_nhan_vien_phu_trach', '=', False)]}"/>
                            <field name="phong_ban_nhan_vien_phu_trach" readonly="1" attrs="{'invisible': [('phong_ban_nhan_vien_phu_trach', '=', False)]}"/>
                            <field name="ngay_tao"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="📊 Thống kê">
                            <field name="so_lan_mua_hang"/>
                            <field name="tong_chi_tieu" widget="monetary"/>
                            <field name="last_activity_date"/>
                            <field name="days_since_last_activity"/>
                        </group>
                        <group string="🤖 AI Insights">
                            <field name="rfm_segment" widget="badge"
                                   decoration-success="rfm_segment == 'vip'"
                                   decoration-info="rfm_segment == 'loyal'"
                                   decoration-warning="rfm_segment == 'at_risk'"
                                   decoration-danger="rfm_segment == 'lost'"/>
                            <field name="churn_probability" widget="progressbar"/>
                            <field name="purchase_probability" widget="progressbar"/>
                            <field name="sentiment_score"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Đơn hàng" name="don_hang">
                            <field name="don_hang_ids">
                                <tree decoration-success="trang_thai=='hoan_thanh'"
                                      decoration-warning="trang_thai=='dang_xu_ly'"
                                      decoration-danger="trang_thai=='huy'">
                                    <field name="ma_don_hang"/>
                                    <field name="ngay_dat_hang"/>
                                    <field name="tong_tien" sum="Tổng" widget="monetary"/>
                                    <field name="trang_thai" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="AI / Đề xuất" name="ai_recommendation">
                            <group>
                                <field name="san_pham_du_doan_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            </group>
                        </page>
                        <page string="Hỗ trợ" name="ho_tro">
                            <field name="ho_tro_ids">
                                <tree decoration-success="trang_thai=='hoan_thanh'"
                                      decoration-info="trang_thai=='dang_xu_ly'">
                                    <field name="ten_yeu_cau"/>
                                    <field name="phuong_thuc"/>
                                    <field name="nhan_vien_id"/>
                                    <field name="ngay_tao"/>
                                    <field name="trang_thai" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Email đã nhận" name="email">
                            <field name="email_ids">
                                <tree>
                                    <field name="chu_de"/>
                                    <field name="ngay_gui"/>
                                    <field name="trang_thai" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Hóa đơn" name="hoa_don">
                            <field name="hoa_don_ids">
                                <tree>
                                    <field name="ma_hoa_don"/>
                                    <field name="don_hang_id"/>
                                    <field name="ngay_hoa_don"/>
                                    <field name="tong_tien" widget="monetary"/>
                                    <field name="trang_thai" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_khach_hang_tree" model="ir.ui.view">
        <field name="name">khach_hang.tree</field>
        <field name="model">khach_hang</field>
        <field name="arch" type="xml">
            <tree string="Khách hàng" decoration-info="phan_loai=='tiem_nang_cao'"
                  decoration-muted="trang_thai=='cu'">
                <field name="ten_khach_hang" decoration-bf="1"/>
                <field name="so_dien_thoai"/>
                <field name="email"/>
                <field name="cong_ty" optional="show"/>
                <field name="phan_loai" widget="badge"/>
                <field name="trang_thai" widget="badge"/>
                <field name="nhan_vien_phu_trach_id"/>
                <field name="so_lan_mua_hang"/>
                <field name="tong_chi_tieu" sum="Tổng" widget="monetary"/>
                <field name="ngay_tao" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View - Enhanced Modern -->
    <record id="view_khach_hang_kanban" model="ir.ui.view">
        <field name="name">khach_hang.kanban</field>
        <field name="model">khach_hang</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile kh_kanban_modern" default_group_by="trang_thai"
                    quick_create="false">
                <field name="id"/>
                <field name="ten_khach_hang"/>
                <field name="so_dien_thoai"/>
                <field name="email"/>
                <field name="phan_loai"/>
                <field name="trang_thai"/>
                <field name="tong_chi_tieu"/>
                <field name="mau_sac"/>
                <field name="rfm_segment"/>
                <field name="don_hang_count"/>
                <field name="ho_tro_count"/>
                <field name="churn_probability"/>
                <field name="nhan_vien_phu_trach_id"/>
                <field name="activity_ids"/>
                <progressbar field="rfm_segment" colors='{"vip": "success", "loyal": "info", "new": "primary", "at_risk": "warning", "lost": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.mau_sac.raw_value)} oe_kanban_card oe_kanban_global_click kh_card_modern">
                            <!-- VIP/Segment Ribbon -->
                            <div t-if="record.rfm_segment.raw_value == 'vip'" class="kh_ribbon kh_ribbon_vip">⭐ VIP</div>
                            <div t-if="record.rfm_segment.raw_value == 'at_risk'" class="kh_ribbon kh_ribbon_risk">⚠️ At Risk</div>
                            <div t-if="record.rfm_segment.raw_value == 'lost'" class="kh_ribbon kh_ribbon_lost">🚨 Lost</div>
                            
                            <!-- Header -->
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span class="kh_customer_name"><field name="ten_khach_hang"/></span>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <i class="fa fa-phone mr-1"/> <field name="so_dien_thoai" widget="phone"/>
                                    </div>
                                </div>
                                <!-- Dropdown Menu -->
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" role="button">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">✏️ Sửa</a>
                                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">🗑️ Xóa</a>
                                        <div class="dropdown-divider"/>
                                        <a role="menuitem" type="object" name="action_view_don_hang" class="dropdown-item">🛒 Xem đơn hàng</a>
                                        <a role="menuitem" type="object" name="action_view_ho_tro" class="dropdown-item">🎧 Xem hỗ trợ</a>
                                        <a role="menuitem" type="object" name="action_gui_email" class="dropdown-item">📧 Gửi email</a>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Body -->
                            <div class="o_kanban_record_body">
                                <div class="kh_email_line">
                                    <i class="fa fa-envelope-o text-muted mr-1"/> 
                                    <field name="email" widget="email"/>
                                </div>
                                <div class="kh_stats_row mt-2">
                                    <span class="kh_stat_badge kh_stat_orders" title="Số đơn hàng">
                                        🛒 <field name="don_hang_count"/>
                                    </span>
                                    <span class="kh_stat_badge kh_stat_support" title="Số yêu cầu hỗ trợ">
                                        🎧 <field name="ho_tro_count"/>
                                    </span>
                                    <span class="kh_stat_badge kh_stat_money" title="Tổng chi tiêu">
                                        💰 <field name="tong_chi_tieu" widget="monetary"/>
                                    </span>
                                </div>
                            </div>
                            
                            <!-- Footer -->
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <span t-if="record.phan_loai.raw_value == 'tiem_nang_cao'" class="badge badge-success">🔥 Tiềm năng cao</span>
                                    <span t-if="record.phan_loai.raw_value == 'tiem_nang_thap'" class="badge badge-secondary">📊 Tiềm năng thấp</span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                    <img t-att-src="kanban_image('nhan_vien', 'hinh_anh', record.nhan_vien_phu_trach_id.raw_value)"
                                         t-att-title="record.nhan_vien_phu_trach_id.value"
                                         t-att-alt="record.nhan_vien_phu_trach_id.value"
                                         width="24" height="24" class="rounded-circle"
                                         t-if="record.nhan_vien_phu_trach_id.raw_value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View - Enhanced -->
    <record id="view_khach_hang_search" model="ir.ui.view">
        <field name="name">khach_hang.search</field>
        <field name="model">khach_hang</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm khách hàng">
                <field name="ten_khach_hang" filter_domain="['|', ('ten_khach_hang', 'ilike', self), ('cong_ty', 'ilike', self)]"/>
                <field name="so_dien_thoai"/>
                <field name="email"/>
                <field name="cong_ty"/>
                <field name="nhan_vien_phu_trach_id"/>
                
                <separator/>
                <filter string="📋 Khách hàng mới" name="moi" domain="[('trang_thai', '=', 'moi')]"/>
                <filter string="🔄 Đang giao dịch" name="dang_giao_dich" domain="[('trang_thai', '=', 'dang_giao_dich')]"/>
                <filter string="📁 Khách cũ" name="cu" domain="[('trang_thai', '=', 'cu')]"/>
                
                <separator/>
                <filter string="🔥 Tiềm năng cao" name="tiem_nang_cao" domain="[('phan_loai', '=', 'tiem_nang_cao')]"/>
                <filter string="🛒 Đã mua hàng" name="da_mua" domain="[('so_lan_mua_hang', '>', 0)]"/>
                <filter string="💰 Chi tiêu cao" name="chi_tieu_cao" domain="[('tong_chi_tieu', '>', 10000000)]"/>
                
                <separator/>
                <filter string="⭐ VIP" name="vip" domain="[('rfm_segment', '=', 'vip')]"/>
                <filter string="💚 Loyal" name="loyal" domain="[('rfm_segment', '=', 'loyal')]"/>
                <filter string="⚠️ At Risk" name="at_risk" domain="[('rfm_segment', '=', 'at_risk')]"/>
                <filter string="🚨 Lost" name="lost" domain="[('rfm_segment', '=', 'lost')]"/>
                <filter string="🆕 New" name="new_customer" domain="[('rfm_segment', '=', 'new')]"/>
                
                <separator/>
                <filter string="🔔 Có hoạt động" name="activities_todo" domain="[('activity_ids', '!=', False)]"/>
                <filter string="⏰ Hoạt động hôm nay" name="activities_today" domain="[('activity_ids.date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="⚠️ Hoạt động quá hạn" name="activities_overdue" domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                
                <group expand="0" string="Nhóm theo">
                    <filter string="Trạng thái" name="group_trang_thai" context="{'group_by':'trang_thai'}"/>
                    <filter string="Phân loại" name="group_phan_loai" context="{'group_by':'phan_loai'}"/>
                    <filter string="RFM Segment" name="group_rfm" context="{'group_by':'rfm_segment'}"/>
                    <filter string="Nhân viên phụ trách" name="group_nhan_vien" context="{'group_by':'nhan_vien_phu_trach_id'}"/>
                    <filter string="Tháng tạo" name="group_month" context="{'group_by':'ngay_tao:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_khach_hang" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">khach_hang</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_khach_hang_search"/>
        <field name="context">{'search_default_dang_giao_dich': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo khách hàng mới
            </p>
            <p>
                Quản lý thông tin khách hàng, theo dõi lịch sử mua hàng và hỗ trợ.
            </p>
        </field>
    </record>

</odoo>
