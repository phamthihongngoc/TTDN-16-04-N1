<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Booking Form View -->
    <record id="view_customer_booking_form" model="ir.ui.view">
        <field name="name">customer.booking.form</field>
        <field name="model">customer.booking</field>
        <field name="arch" type="xml">
            <form string="Lịch hẹn khách hàng">
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận"
                            class="btn-primary" icon="fa-check"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_done" type="object" string="Hoàn thành"
                            class="btn-success" icon="fa-check-circle"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_cancel" type="object" string="Hủy"
                            class="btn-danger" icon="fa-times"
                            attrs="{'invisible': [('state', 'in', ('done', 'cancelled'))]}"
                            confirm="Bạn có chắc muốn hủy lịch hẹn này?"/>
                    <button name="action_reset_draft" type="object" string="Đặt lại"
                            class="btn-secondary" icon="fa-undo"
                            attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <field name="state" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <!-- Zoom button -->
                        <button class="oe_stat_button" type="object" 
                                name="action_open_zoom_meeting"
                                icon="fa-video-camera"
                                attrs="{'invisible': [('zoom_join_url', '=', False)]}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Zoom Meeting</span>
                            </div>
                        </button>
                        <!-- Google Calendar button -->
                        <button class="oe_stat_button" type="object" 
                                name="action_open_google_calendar"
                                icon="fa-google"
                                attrs="{'invisible': [('google_calendar_link', '=', False)]}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Google Calendar</span>
                            </div>
                        </button>
                        <!-- Odoo Calendar button -->
                        <button class="oe_stat_button" type="object" 
                                name="action_open_calendar_event"
                                icon="fa-calendar"
                                attrs="{'invisible': [('calendar_event_id', '=', False)]}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Calendar</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Đã hủy" bg_color="bg-danger"
                            attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                    <widget name="web_ribbon" title="Hoàn thành" bg_color="bg-success"
                            attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="title" placeholder="Tiêu đề cuộc hẹn"
                                   attrs="{'readonly': [('state', 'not in', ('draft',))]}"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Thông tin khách hàng">
                            <field name="khach_hang_id" 
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"
                                   options="{'no_create': True}"/>
                            <field name="customer_email"/>
                            <field name="customer_phone"/>
                        </group>
                        <group string="Người phụ trách">
                            <field name="user_id" 
                                   attrs="{'readonly': [('state', 'not in', ('draft',))]}"/>
                            <field name="attendee_ids" widget="many2many_tags"
                                   attrs="{'readonly': [('state', 'not in', ('draft',))]}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Thời gian">
                            <field name="booking_date"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="booking_time" widget="float_time"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="duration"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="start_datetime" readonly="1"/>
                            <field name="end_datetime" readonly="1"/>
                        </group>
                        <group string="Hình thức">
                            <field name="meeting_type"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="location"
                                   attrs="{'invisible': [('meeting_type', '=', 'online')],
                                           'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </group>
                    
                    <!-- Zoom Info (visible when online meeting confirmed) -->
                    <group string="Thông tin Zoom Meeting" 
                           attrs="{'invisible': ['|', ('meeting_type', '!=', 'online'), ('zoom_join_url', '=', False)]}">
                        <group>
                            <field name="zoom_meeting_id" readonly="1"/>
                            <field name="zoom_password" readonly="1"/>
                            <field name="zoom_sync_status" readonly="1" widget="badge"
                                   decoration-success="zoom_sync_status == 'synced'"
                                   decoration-danger="zoom_sync_status == 'error'"
                                   decoration-info="zoom_sync_status == 'pending'"/>
                        </group>
                        <group>
                            <field name="zoom_join_url" readonly="1" widget="url"/>
                            <button name="action_open_zoom_host" type="object"
                                    string="Bắt đầu Meeting (Host)" class="btn-primary"
                                    icon="fa-play" attrs="{'invisible': [('zoom_start_url', '=', False)]}"/>
                        </group>
                    </group>
                    
                    <!-- Google Calendar Sync -->
                    <group string="Đồng bộ Google Calendar"
                           attrs="{'invisible': [('state', '=', 'draft')]}">
                        <group>
                            <field name="google_calendar_event_id" readonly="1"/>
                            <field name="google_sync_status" readonly="1" widget="badge"
                                   decoration-success="google_sync_status == 'synced'"
                                   decoration-danger="google_sync_status == 'error'"
                                   decoration-info="google_sync_status == 'pending'"
                                   decoration-muted="google_sync_status == 'not_synced'"/>
                        </group>
                        <group>
                            <field name="google_calendar_link" readonly="1" widget="url"/>
                            <button name="action_sync_google_calendar" type="object"
                                    string="Đồng bộ Google Calendar" class="btn-secondary"
                                    icon="fa-refresh"
                                    attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Mô tả" name="description">
                            <field name="description" nolabel="1" placeholder="Mô tả chi tiết cuộc hẹn..."
                                   attrs="{'readonly': [('state', 'not in', ('draft', 'confirmed'))]}"/>
                        </page>
                        <page string="Ghi chú cuộc họp" name="meeting_notes"
                              attrs="{'invisible': [('state', '=', 'draft')]}">
                            <field name="meeting_notes" nolabel="1" placeholder="Ghi chú sau cuộc họp..."/>
                        </page>
                        <page string="Ghi chú nội bộ" name="internal_notes">
                            <field name="notes" nolabel="1" placeholder="Ghi chú nội bộ..."/>
                        </page>
                    </notebook>
                    
                    <!-- Hidden fields -->
                    <field name="calendar_event_id" invisible="1"/>
                    <field name="zoom_start_url" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Customer Booking Tree View -->
    <record id="view_customer_booking_tree" model="ir.ui.view">
        <field name="name">customer.booking.tree</field>
        <field name="model">customer.booking</field>
        <field name="arch" type="xml">
            <tree string="Lịch hẹn" decoration-danger="state == 'cancelled'"
                  decoration-success="state == 'done'" decoration-info="state == 'confirmed'">
                <field name="name"/>
                <field name="title"/>
                <field name="khach_hang_id"/>
                <field name="booking_date"/>
                <field name="booking_time" widget="float_time"/>
                <field name="duration"/>
                <field name="meeting_type"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'confirmed'"
                       decoration-muted="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="zoom_sync_status" optional="hide" widget="badge"
                       decoration-success="zoom_sync_status == 'synced'"
                       decoration-danger="zoom_sync_status == 'error'"/>
                <field name="google_sync_status" optional="hide" widget="badge"
                       decoration-success="google_sync_status == 'synced'"
                       decoration-danger="google_sync_status == 'error'"/>
            </tree>
        </field>
    </record>

    <!-- Customer Booking Kanban View -->
    <record id="view_customer_booking_kanban" model="ir.ui.view">
        <field name="name">customer.booking.kanban</field>
        <field name="model">customer.booking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="title"/>
                <field name="khach_hang_id"/>
                <field name="booking_date"/>
                <field name="booking_time"/>
                <field name="meeting_type"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="zoom_join_url"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/> - <field name="title"/>
                                        </strong>
                                    </div>
                                    <span class="badge" t-attf-class="#{record.meeting_type.raw_value == 'online' ? 'bg-primary' : 'bg-secondary'}">
                                        <t t-if="record.meeting_type.raw_value == 'online'">
                                            <i class="fa fa-video-camera"/> Online
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-building"/> Offline
                                        </t>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <i class="fa fa-user"/> <field name="khach_hang_id"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-calendar"/> <field name="booking_date"/>
                                        <i class="fa fa-clock-o ml-2"/> <field name="booking_time" widget="float_time"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <t t-if="record.zoom_join_url.raw_value">
                                            <a t-att-href="record.zoom_join_url.raw_value" target="_blank"
                                               class="btn btn-sm btn-primary" title="Join Zoom">
                                                <i class="fa fa-video-camera"/>
                                            </a>
                                        </t>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <img t-att-src="kanban_image('res.users', 'image_128', record.user_id.raw_value)"
                                             t-att-alt="record.user_id.value"
                                             class="oe_kanban_avatar"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Customer Booking Calendar View -->
    <record id="view_customer_booking_calendar" model="ir.ui.view">
        <field name="name">customer.booking.calendar</field>
        <field name="model">customer.booking</field>
        <field name="arch" type="xml">
            <calendar string="Lịch hẹn" date_start="start_datetime" date_stop="end_datetime"
                      color="meeting_type" event_open_popup="true" quick_add="false">
                <field name="title"/>
                <field name="khach_hang_id"/>
                <field name="user_id"/>
                <field name="meeting_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Customer Booking Search View -->
    <record id="view_customer_booking_search" model="ir.ui.view">
        <field name="name">customer.booking.search</field>
        <field name="model">customer.booking</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm lịch hẹn">
                <field name="name"/>
                <field name="title"/>
                <field name="khach_hang_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="filter_draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Đã xác nhận" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_done" string="Hoàn thành" domain="[('state', '=', 'done')]"/>
                <filter name="filter_cancelled" string="Đã hủy" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_online" string="Trực tuyến (Zoom)" domain="[('meeting_type', '=', 'online')]"/>
                <filter name="filter_offline" string="Trực tiếp" domain="[('meeting_type', '=', 'offline')]"/>
                <separator/>
                <filter name="filter_today" string="Hôm nay" domain="[('booking_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_upcoming" string="Sắp tới" domain="[('booking_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_my" string="Lịch của tôi" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                    <filter name="group_customer" string="Khách hàng" context="{'group_by': 'khach_hang_id'}"/>
                    <filter name="group_date" string="Ngày hẹn" context="{'group_by': 'booking_date'}"/>
                    <filter name="group_user" string="Người phụ trách" context="{'group_by': 'user_id'}"/>
                    <filter name="group_type" string="Hình thức" context="{'group_by': 'meeting_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Customer Booking Action -->
    <record id="action_customer_booking" model="ir.actions.act_window">
        <field name="name">Lịch hẹn khách hàng</field>
        <field name="res_model">customer.booking</field>
        <field name="view_mode">tree,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_customer_booking_search"/>
        <field name="context">{'search_default_filter_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo lịch hẹn đầu tiên
            </p>
            <p>
                Đặt lịch hẹn với khách hàng và tự động:
                <ul>
                    <li>Tạo Zoom Meeting (nếu chọn họp trực tuyến)</li>
                    <li>Đồng bộ lên Google Calendar</li>
                    <li>Gửi email mời đến khách hàng</li>
                </ul>
            </p>
        </field>
    </record>

    <!-- My Bookings Action -->
    <record id="action_my_bookings" model="ir.actions.act_window">
        <field name="name">Lịch hẹn của tôi</field>
        <field name="res_model">customer.booking</field>
        <field name="view_mode">calendar,tree,kanban,form</field>
        <field name="search_view_id" ref="view_customer_booking_search"/>
        <field name="context">{'search_default_filter_my': 1, 'search_default_filter_upcoming': 1}</field>
    </record>
</odoo>
