<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View with Calendar Picker -->
    <record id="view_booking_quick_create_wizard_form" model="ir.ui.view">
        <field name="name">booking.quick.create.wizard.form</field>
        <field name="model">booking.quick.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Đặt lịch hẹn nhanh">
                <sheet>
                    <!-- Header with customer info -->
                    <div class="oe_title">
                        <h1>
                            <span class="text-muted">Đặt lịch hẹn cho: </span>
                            <field name="customer_name" readonly="1" class="oe_inline"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Thông tin khách hàng">
                            <field name="khach_hang_id" invisible="1"/>
                            <field name="customer_email" readonly="1"/>
                            <field name="customer_phone" readonly="1"/>
                        </group>
                        <group string="Người phụ trách">
                            <field name="user_id"/>
                            <field name="attendee_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    
                    <separator string="Chi tiết cuộc hẹn"/>
                    
                    <group>
                        <group>
                            <field name="title" placeholder="VD: Tư vấn sản phẩm, Demo phần mềm..."/>
                            <field name="meeting_type" widget="radio"/>
                            <field name="location" attrs="{'invisible': [('meeting_type', '=', 'online')], 'required': [('meeting_type', '=', 'offline')]}"
                                   placeholder="VD: Văn phòng công ty, Quán cafe ABC..."/>
                        </group>
                        <group>
                            <field name="description" placeholder="Ghi chú thêm về cuộc hẹn..."/>
                        </group>
                    </group>
                    
                    <separator string="Chọn thời gian"/>
                    
                    <!-- Main calendar/datetime picker section -->
                    <group>
                        <group>
                            <field name="start_datetime" widget="daterange" options="{'related_end_date': 'end_datetime'}"/>
                            <field name="end_datetime" invisible="1"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                        </group>
                        <group>
                            <!-- Alternative: separate date and time pickers -->
                        </group>
                    </group>
                    
                    <separator string="Tùy chọn đồng bộ"/>
                    
                    <group>
                        <group string="Google Calendar">
                            <field name="google_integration_available" invisible="1"/>
                            <field name="zoom_integration_available" invisible="1"/>
                            
                            <div attrs="{'invisible': [('google_integration_available', '=', False)]}">
                                <field name="sync_google_calendar" class="oe_inline"/>
                                <label for="sync_google_calendar" string="Đồng bộ Google Calendar"/>
                                <span class="badge badge-success ml-2" style="background-color: #28a745; color: white; padding: 3px 8px; border-radius: 4px;">✓ Đã kết nối</span>
                            </div>
                            <div class="alert alert-warning py-2" role="alert" attrs="{'invisible': [('google_integration_available', '=', True)]}">
                                <i class="fa fa-warning" title="Cảnh báo"/> Google Calendar chưa được cấu hình.
                            </div>
                        </group>
                        <group string="Zoom Meeting">
                            <div attrs="{'invisible': ['|', ('meeting_type', '=', 'offline'), ('zoom_integration_available', '=', False)]}">
                                <field name="create_zoom_meeting" class="oe_inline"/>
                                <label for="create_zoom_meeting" string="Tạo cuộc họp Zoom"/>
                                <span class="badge badge-success ml-2" style="background-color: #28a745; color: white; padding: 3px 8px; border-radius: 4px;">✓ Đã kết nối</span>
                            </div>
                            <div class="text-muted" attrs="{'invisible': [('meeting_type', '=', 'online')]}">
                                <i class="fa fa-info-circle" title="Thông tin"/> Chọn "Trực tuyến (Zoom)" để tạo cuộc họp Zoom
                            </div>
                            <div class="alert alert-warning py-2" role="alert" attrs="{'invisible': ['|', ('meeting_type', '=', 'offline'), ('zoom_integration_available', '=', True)]}">
                                <i class="fa fa-warning" title="Cảnh báo"/> Zoom chưa được cấu hình.
                            </div>
                        </group>
                    </group>
                    
                </sheet>
                <footer>
                    <button name="action_create_booking" string="Xác nhận đặt lịch" type="object" class="btn-primary" icon="fa-check"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action for the wizard -->
    <record id="action_booking_quick_create_wizard" model="ir.actions.act_window">
        <field name="name">Đặt lịch hẹn</field>
        <field name="res_model">booking.quick.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_booking_quick_create_wizard_form"/>
    </record>
    
</odoo>
