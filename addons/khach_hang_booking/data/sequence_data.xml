<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Customer Booking -->
    <record id="seq_customer_booking" model="ir.sequence">
        <field name="name">Customer Booking Sequence</field>
        <field name="code">customer.booking</field>
