<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Email Template: Cần duyệt hồ sơ -->
    <record id="email_template_ho_so_approval" model="mail.template">
        <field name="name">Hồ Sơ Nhân Viên: Cần Duyệt</field>
        <field name="model_id" ref="model_ho_so_nhan_vien"/>
        <field name="subject">Hồ sơ cần duyệt: ${object.name}</field>
        <field name="email_to">${ctx.get('recipient_user').email}</field>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%; background-color: #f4f4f4;">
                    <tr>
                        <td align="center" valign="top">
                            <table border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff;">
                                <!-- Header -->
                                <tr>
                                    <td align="center" valign="top" style="padding: 40px 20px; background-color: #1f77b4;">
                                        <h1 style="color: #ffffff; margin: 0; font-size: 24px;">Hồ Sơ Cần Duyệt</h1>
                                    </td>
                                </tr>
                                
                                <!-- Content -->
                                <tr>
                                    <td style="padding: 30px 20px;">
                                        <p style="margin: 0 0 15px;">Xin chào <strong>${ctx.get('recipient_user').name}</strong>,</p>
                                        
                                        <p style="margin: 0 0 15px;">
                                            Nhân viên <strong>${object.nhan_vien_id.name}</strong> đã gửi hồ sơ cần duyệt:
                                        </p>
                                        
                                        <table style="width: 100%; margin: 20px 0; border-collapse: collapse;">
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold; width: 30%;">Tên hồ sơ:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${object.name}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Loại hồ sơ:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${dict(object._fields['loai_ho_so'].selection).get(object.loai_ho_so)}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Người nộp:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${object.nguoi_nop_id.name}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Ngày nộp:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${format_datetime(object.ngay_nop, dt_format='dd/MM/yyyy HH:mm:ss')}</td>
                                            </tr>
                                            <t t-if="object.ghi_chu">
                                                <tr>
                                                    <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Ghi chú:</td>
                                                    <td style="padding: 8px; border: 1px solid #ddd;">${object.ghi_chu}</td>
                                                </tr>
                                            </t>
                                        </table>
                                        
                                        <p style="margin: 20px 0;">
                                            <a href="${object.get_base_url()}/web#id=${object.id}&amp;model=ho_so.nhan_vien&amp;view_type=form" 
                                               style="display: inline-block; padding: 12px 30px; background-color: #1f77b4; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                                Xem &amp; Duyệt Hồ Sơ
                                            </a>
                                        </p>
                                    </td>
                                </tr>
                                
                                <!-- Footer -->
                                <tr>
                                    <td align="center" style="padding: 20px; background-color: #f9f9f9; color: #666;">
                                        <p style="margin: 0; font-size: 12px;">Email tự động từ hệ thống quản lý nhân sự</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </field>
    </record>

    <!-- Email Template: Hồ sơ đã được duyệt -->
    <record id="email_template_ho_so_approved" model="mail.template">
        <field name="name">Hồ Sơ Nhân Viên: Đã Duyệt</field>
        <field name="model_id" ref="model_ho_so_nhan_vien"/>
        <field name="subject">Hồ sơ đã được duyệt: ${object.name}</field>
        <field name="email_to">${ctx.get('recipient_user').email if ctx.get('recipient_user') else object.nguoi_nop_id.email}</field>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%; background-color: #f4f4f4;">
                    <tr>
                        <td align="center" valign="top">
                            <table border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff;">
                                <!-- Header -->
                                <tr>
                                    <td align="center" valign="top" style="padding: 40px 20px; background-color: #28a745;">
                                        <h1 style="color: #ffffff; margin: 0; font-size: 24px;">✓ Hồ Sơ Đã Được Duyệt</h1>
                                    </td>
                                </tr>
                                
                                <!-- Content -->
                                <tr>
                                    <td style="padding: 30px 20px;">
                                        <p style="margin: 0 0 15px;">Xin chào <strong>${object.nguoi_nop_id.name}</strong>,</p>
                                        
                                        <p style="margin: 0 0 15px;">
                                            Hồ sơ của bạn đã được duyệt thành công!
                                        </p>
                                        
                                        <table style="width: 100%; margin: 20px 0; border-collapse: collapse;">
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold; width: 30%;">Tên hồ sơ:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${object.name}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Loại hồ sơ:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${dict(object._fields['loai_ho_so'].selection).get(object.loai_ho_so)}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Người duyệt:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${object.nguoi_duyet_id.name}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Ngày duyệt:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${format_datetime(object.ngay_duyet, dt_format='dd/MM/yyyy HH:mm:ss')}</td>
                                            </tr>
                                        </table>
                                        
                                        <p style="margin: 20px 0;">
                                            <a href="${object.get_base_url()}/web#id=${object.id}&amp;model=ho_so.nhan_vien&amp;view_type=form" 
                                               style="display: inline-block; padding: 12px 30px; background-color: #28a745; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                                Xem Chi Tiết
                                            </a>
                                        </p>
                                    </td>
                                </tr>
                                
                                <!-- Footer -->
                                <tr>
                                    <td align="center" style="padding: 20px; background-color: #f9f9f9; color: #666;">
                                        <p style="margin: 0; font-size: 12px;">Email tự động từ hệ thống quản lý nhân sự</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </field>
    </record>

    <!-- Email Template: Hồ sơ bị từ chối -->
    <record id="email_template_ho_so_rejected" model="mail.template">
        <field name="name">Hồ Sơ Nhân Viên: Bị Từ Chối</field>
        <field name="model_id" ref="model_ho_so_nhan_vien"/>
        <field name="subject">Hồ sơ bị từ chối: ${object.name}</field>
        <field name="email_to">${ctx.get('recipient_user').email if ctx.get('recipient_user') else object.nguoi_nop_id.email}</field>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%; background-color: #f4f4f4;">
                    <tr>
                        <td align="center" valign="top">
                            <table border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff;">
                                <!-- Header -->
                                <tr>
                                    <td align="center" valign="top" style="padding: 40px 20px; background-color: #dc3545;">
                                        <h1 style="color: #ffffff; margin: 0; font-size: 24px;">✗ Hồ Sơ Bị Từ Chối</h1>
                                    </td>
                                </tr>
                                
                                <!-- Content -->
                                <tr>
                                    <td style="padding: 30px 20px;">
                                        <p style="margin: 0 0 15px;">Xin chào <strong>${object.nguoi_nop_id.name}</strong>,</p>
                                        
                                        <p style="margin: 0 0 15px;">
                                            Rất tiếc, hồ sơ của bạn đã bị từ chối.
                                        </p>
                                        
                                        <table style="width: 100%; margin: 20px 0; border-collapse: collapse;">
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold; width: 30%;">Tên hồ sơ:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${object.name}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Loại hồ sơ:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${dict(object._fields['loai_ho_so'].selection).get(object.loai_ho_so)}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Người từ chối:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${object.nguoi_duyet_id.name}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Ngày từ chối:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${format_datetime(object.ngay_duyet, dt_format='dd/MM/yyyy HH:mm:ss')}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Lý do:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd; color: #dc3545; font-weight: bold;">${object.ly_do_tu_choi}</td>
                                            </tr>
                                        </table>
                                        
                                        <p style="margin: 20px 0;">
                                            Vui lòng kiểm tra lại thông tin và nộp lại hồ sơ.
                                        </p>
                                        
                                        <p style="margin: 20px 0;">
                                            <a href="${object.get_base_url()}/web#id=${object.id}&amp;model=ho_so.nhan_vien&amp;view_type=form" 
                                               style="display: inline-block; padding: 12px 30px; background-color: #dc3545; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                                Xem Chi Tiết
                                            </a>
                                        </p>
                                    </td>
                                </tr>
                                
                                <!-- Footer -->
                                <tr>
                                    <td align="center" style="padding: 20px; background-color: #f9f9f9; color: #666;">
                                        <p style="margin: 0; font-size: 12px;">Email tự động từ hệ thống quản lý nhân sự</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </field>
    </record>

    <!-- Email Template: Sắp hết hạn -->
    <record id="email_template_ho_so_expiry" model="mail.template">
        <field name="name">Hồ Sơ Nhân Viên: Sắp Hết Hạn</field>
        <field name="model_id" ref="model_ho_so_nhan_vien"/>
        <field name="subject">⚠ Hồ sơ sắp hết hạn: ${object.name}</field>
        <field name="email_to">${object.nhan_vien_id.email or object.nguoi_nop_id.email}</field>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%; background-color: #f4f4f4;">
                    <tr>
                        <td align="center" valign="top">
                            <table border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff;">
                                <!-- Header -->
                                <tr>
                                    <td align="center" valign="top" style="padding: 40px 20px; background-color: #ffc107;">
                                        <h1 style="color: #ffffff; margin: 0; font-size: 24px;">⚠ Hồ Sơ Sắp Hết Hạn</h1>
                                    </td>
                                </tr>
                                
                                <!-- Content -->
                                <tr>
                                    <td style="padding: 30px 20px;">
                                        <p style="margin: 0 0 15px;">Xin chào <strong>${object.nhan_vien_id.name}</strong>,</p>
                                        
                                        <p style="margin: 0 0 15px;">
                                            Hồ sơ của bạn sắp hết hạn, vui lòng chuẩn bị cập nhật!
                                        </p>
                                        
                                        <table style="width: 100%; margin: 20px 0; border-collapse: collapse;">
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold; width: 30%;">Tên hồ sơ:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${object.name}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Loại hồ sơ:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">${dict(object._fields['loai_ho_so'].selection).get(object.loai_ho_so)}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Ngày hết hạn:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd; color: #ffc107; font-weight: bold;">${format_date(object.ngay_het_han, date_format='dd/MM/yyyy')}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px; background-color: #f9f9f9; border: 1px solid #ddd; font-weight: bold;">Số ngày còn lại:</td>
                                                <td style="padding: 8px; border: 1px solid #ddd; color: #dc3545; font-weight: bold;">${object.so_ngay_con_lai} ngày</td>
                                            </tr>
                                        </table>
                                        
                                        <p style="margin: 20px 0; padding: 15px; background-color: #fff3cd; border-left: 4px solid #ffc107;">
                                            <strong>Lưu ý:</strong> Vui lòng cập nhật hồ sơ mới trước khi hết hạn để tránh gián đoạn công việc.
                                        </p>
                                        
                                        <p style="margin: 20px 0;">
                                            <a href="${object.get_base_url()}/web#id=${object.id}&amp;model=ho_so.nhan_vien&amp;view_type=form" 
                                               style="display: inline-block; padding: 12px 30px; background-color: #ffc107; color: #000000; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                                Cập Nhật Hồ Sơ
                                            </a>
                                        </p>
                                    </td>
                                </tr>
                                
                                <!-- Footer -->
                                <tr>
                                    <td align="center" style="padding: 20px; background-color: #f9f9f9; color: #666;">
                                        <p style="margin: 0; font-size: 12px;">Email tự động từ hệ thống quản lý nhân sự</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </field>
    </record>
</odoo>
