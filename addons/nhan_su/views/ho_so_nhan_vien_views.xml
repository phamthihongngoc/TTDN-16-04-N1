<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_ho_so_nhan_vien_form" model="ir.ui.view">
        <field name="name">ho.so.nhan.vien.form</field>
        <field name="model">ho_so.nhan_vien</field>
        <field name="arch" type="xml">
            <form string="Hồ Sơ Nhân Viên">
                <header>
                    <button name="action_gui_duyet" string="Gửi Duyệt" type="object" 
                            class="oe_highlight" states="nhap"/>
                    <button name="action_duyet" string="Duyệt" type="object" 
                            class="oe_highlight" states="cho_duyet"
                            groups="nhan_su.group_quan_tri_nhan_su"/>
                    <button name="action_tu_choi" string="Từ Chối" type="object" 
                            states="cho_duyet"
                            groups="nhan_su.group_quan_tri_nhan_su"/>
                    <button name="action_cap_nhat_phien_ban" string="Cập Nhật Phiên Bản" type="object" 
                            states="da_duyet"/>
                    <button name="action_view_history" string="Lịch Sử Phiên Bản" type="object" 
                            icon="fa-history" attrs="{'invisible': [('phien_ban', '=', 1)]}"/>
                    <button name="action_download" string="Tải Xuống" type="object" 
                            icon="fa-download" attrs="{'invisible': [('file_dinh_kem', '=', False)]}"/>
                    <field name="trang_thai" widget="statusbar" 
                           statusbar_visible="nhap,cho_duyet,da_duyet"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_history" type="object"
                                class="oe_stat_button" icon="fa-history"
                                attrs="{'invisible': [('phien_ban', '=', 1)]}">
                            <field name="phien_ban" widget="statinfo" string="Phiên bản"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tên hồ sơ..."/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="thong_tin_chung">
                            <field name="nhan_vien_id" options="{'no_create': True}"/>
                            <field name="loai_ho_so"/>
                            <field name="bat_buoc"/>
                            <field name="nguoi_nop_id" readonly="1"/>
                            <field name="ngay_nop" readonly="1"/>
                        </group>
                        <group name="thong_tin_ho_so">
                            <field name="ngay_cap"/>
                            <field name="ngay_het_han"/>
                            <field name="con_hieu_luc" invisible="1"/>
                            <field name="so_ngay_con_lai" 
                                   attrs="{'invisible': [('ngay_het_han', '=', False)]}"
                                   decoration-danger="so_ngay_con_lai &lt;= 30"
                                   decoration-warning="so_ngay_con_lai &lt;= 60"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="File Đính Kèm" name="file">
                            <group>
                                <field name="file_dinh_kem" filename="file_name" widget="binary"/>
                                <field name="file_name" invisible="1"/>
                                <field name="file_size" widget="float" readonly="1"/>
                                <field name="file_type" readonly="1"/>
                            </group>
                        </page>
                        
                        <page string="Thông Tin Duyệt" name="duyet" 
                              attrs="{'invisible': [('trang_thai', '=', 'nhap')]}">
                            <group>
                                <group>
                                    <field name="nguoi_duyet_id" readonly="1"/>
                                    <field name="ngay_duyet" readonly="1"/>
                                </group>
                                <group>
                                    <field name="ly_do_tu_choi" readonly="1" 
                                           attrs="{'invisible': [('trang_thai', '!=', 'tu_choi')]}"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Ghi Chú" name="ghi_chu">
                            <field name="ghi_chu" placeholder="Ghi chú về hồ sơ..."/>
                        </page>
                        
                        <page string="Phiên Bản" name="phien_ban" 
                              attrs="{'invisible': [('phien_ban', '=', 1)]}">
                            <group>
                                <field name="ho_so_goc_id" readonly="1"/>
                                <field name="ho_so_moi_nhat" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_ho_so_nhan_vien_tree" model="ir.ui.view">
        <field name="name">ho.so.nhan.vien.tree</field>
        <field name="model">ho_so.nhan_vien</field>
        <field name="arch" type="xml">
            <tree string="Hồ Sơ Nhân Viên" 
                  decoration-success="trang_thai == 'da_duyet'"
                  decoration-info="trang_thai == 'cho_duyet'"
                  decoration-muted="trang_thai == 'nhap'"
                  decoration-danger="trang_thai == 'tu_choi' or trang_thai == 'het_han'"
                  decoration-warning="so_ngay_con_lai &lt;= 30 and so_ngay_con_lai &gt; 0">
                <field name="name"/>
                <field name="nhan_vien_id"/>
                <field name="loai_ho_so"/>
                <field name="bat_buoc" widget="boolean_toggle"/>
                <field name="file_name"/>
                <field name="file_size"/>
                <field name="ngay_cap"/>
                <field name="ngay_het_han"/>
                <field name="so_ngay_con_lai" optional="hide"/>
                <field name="con_hieu_luc" widget="boolean_toggle" optional="hide"/>
                <field name="phien_ban"/>
                <field name="trang_thai" widget="badge" 
                       decoration-success="trang_thai == 'da_duyet'"
                       decoration-info="trang_thai == 'cho_duyet'"
                       decoration-warning="trang_thai == 'nhap'"
                       decoration-danger="trang_thai in ['tu_choi', 'het_han']"/>
                <field name="nguoi_nop_id" optional="hide"/>
                <field name="nguoi_duyet_id" optional="hide"/>
                <field name="ngay_duyet" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_ho_so_nhan_vien_kanban" model="ir.ui.view">
        <field name="name">ho.so.nhan.vien.kanban</field>
        <field name="model">ho_so.nhan_vien</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="trang_thai">
                <field name="name"/>
                <field name="nhan_vien_id"/>
                <field name="loai_ho_so"/>
                <field name="trang_thai"/>
                <field name="file_name"/>
                <field name="file_type"/>
                <field name="ngay_het_han"/>
                <field name="so_ngay_con_lai"/>
                <field name="bat_buoc"/>
                <field name="phien_ban"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="nhan_vien_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <span t-if="record.bat_buoc.raw_value" class="badge badge-danger">
                                        Bắt buộc
                                    </span>
                                </div>
                            </div>
                            
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-tag"/> <field name="loai_ho_so"/>
                                </div>
                                <div t-if="record.file_name.raw_value">
                                    <i class="fa fa-file"/> 
                                    <field name="file_name"/>
                                    <t t-if="record.file_type.raw_value">
                                        (<field name="file_type"/>)
                                    </t>
                                </div>
                                <div t-if="record.ngay_het_han.raw_value" 
                                     t-attf-class="{{record.so_ngay_con_lai.raw_value &lt;= 30 and record.so_ngay_con_lai.raw_value &gt; 0 ? 'text-danger' : ''}}">
                                    <i class="fa fa-clock-o"/> Hết hạn: <field name="ngay_het_han"/>
                                    <t t-if="record.so_ngay_con_lai.raw_value &gt; 0">
                                        (<field name="so_ngay_con_lai"/> ngày)
                                    </t>
                                </div>
                                <div t-if="record.phien_ban.raw_value &gt; 1">
                                    <i class="fa fa-history"/> Phiên bản: <field name="phien_ban"/>
                                </div>
                            </div>
                            
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="trang_thai" widget="label_selection"
                                           options="{'classes': {'da_duyet': 'success', 'cho_duyet': 'info', 'nhap': 'warning', 'tu_choi': 'danger', 'het_han': 'danger'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_ho_so_nhan_vien_search" model="ir.ui.view">
        <field name="name">ho.so.nhan.vien.search</field>
        <field name="model">ho_so.nhan_vien</field>
        <field name="arch" type="xml">
            <search string="Tìm Kiếm Hồ Sơ">
                <field name="name" string="Tên hồ sơ"/>
                <field name="nhan_vien_id"/>
                <field name="loai_ho_so"/>
                <field name="nguoi_nop_id"/>
                <field name="nguoi_duyet_id"/>
                
                <filter string="Hồ sơ của tôi" name="my_documents" 
                        domain="[('nguoi_nop_id', '=', uid)]"/>
                <filter string="Chờ duyệt" name="pending" 
                        domain="[('trang_thai', '=', 'cho_duyet')]"/>
                <filter string="Đã duyệt" name="approved" 
                        domain="[('trang_thai', '=', 'da_duyet')]"/>
                <filter string="Từ chối" name="rejected" 
                        domain="[('trang_thai', '=', 'tu_choi')]"/>
                <filter string="Hết hạn" name="expired" 
                        domain="[('trang_thai', '=', 'het_han')]"/>
                
                <separator/>
                <filter string="Bắt buộc" name="mandatory" 
                        domain="[('bat_buoc', '=', True)]"/>
                <filter string="Còn hiệu lực" name="valid" 
                        domain="[('con_hieu_luc', '=', True)]"/>
                
                <separator/>
                <filter string="Ngày nộp" name="ngay_nop" date="ngay_nop"/>
                <filter string="Ngày hết hạn" name="ngay_het_han" date="ngay_het_han"/>
                
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhân viên" name="group_nhan_vien" 
                            context="{'group_by': 'nhan_vien_id'}"/>
                    <filter string="Loại hồ sơ" name="group_loai" 
                            context="{'group_by': 'loai_ho_so'}"/>
                    <filter string="Trạng thái" name="group_trang_thai" 
                            context="{'group_by': 'trang_thai'}"/>
                    <filter string="Người duyệt" name="group_nguoi_duyet" 
                            context="{'group_by': 'nguoi_duyet_id'}"/>
                    <filter string="Ngày nộp" name="group_ngay_nop" 
                            context="{'group_by': 'ngay_nop'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ho_so_nhan_vien" model="ir.actions.act_window">
        <field name="name">Hồ Sơ Nhân Viên</field>
        <field name="res_model">ho_so.nhan_vien</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo hồ sơ nhân viên mới
            </p>
            <p>
                Quản lý các hồ sơ nhân viên như CMND, bằng cấp, hợp đồng, v.v.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_ho_so_nhan_vien"
              name="Hồ Sơ Nhân Viên"
              parent="menu_quan_ly"
              action="action_ho_so_nhan_vien"
              sequence="35"/>

</odoo>
