<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ==================== LOẠI NGHỈ PHÉP ==================== -->
    
    <record id="view_loai_nghi_phep_form" model="ir.ui.view">
        <field name="name">loai_nghi_phep.form</field>
        <field name="model">loai_nghi_phep</field>
        <field name="arch" type="xml">
            <form string="Loại nghỉ phép">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="co_luong"/>
                            <field name="so_ngay_mac_dinh"/>
                            <field name="cho_phep_cong_don"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="ghi_chu"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_loai_nghi_phep_tree" model="ir.ui.view">
        <field name="name">loai_nghi_phep.tree</field>
        <field name="model">loai_nghi_phep</field>
        <field name="arch" type="xml">
            <tree string="Loại nghỉ phép">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="so_ngay_mac_dinh"/>
                <field name="co_luong"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    
    <record id="action_loai_nghi_phep" model="ir.actions.act_window">
        <field name="name">Loại nghỉ phép</field>
        <field name="res_model">loai_nghi_phep</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <!-- ==================== ĐƠN NGHỈ PHÉP ==================== -->
    
    <record id="view_don_nghi_phep_form" model="ir.ui.view">
        <field name="name">don_nghi_phep.form</field>
        <field name="model">don_nghi_phep</field>
        <field name="arch" type="xml">
            <form string="Đơn nghỉ phép">
                <header>
                    <button name="action_gui_duyet" type="object" string="Gửi duyệt"
                            class="btn-primary"
                            attrs="{'invisible': [('trang_thai', '!=', 'nhap')]}"/>
                    <button name="action_duyet" type="object" string="Duyệt"
                            class="btn-success"
                            attrs="{'invisible': [('trang_thai', '!=', 'cho_duyet')]}"
                            groups="nhan_su.group_quan_tri_nhan_su"/>
                    <button name="action_tu_choi" type="object" string="Tu choi"
                            class="btn-danger"
                            attrs="{'invisible': [('trang_thai', '!=', 'cho_duyet')]}"
                            groups="nhan_su.group_quan_tri_nhan_su"/>
                    <button name="action_huy" type="object" string="Huy"
                            attrs="{'invisible': [('trang_thai', 'in', ['huy', 'tu_choi'])]}"/>
                    <button name="action_nhap_lai" type="object" string="Nhap lai"
                            attrs="{'invisible': [('trang_thai', 'not in', ['tu_choi', 'huy'])]}"/>
                    <field name="trang_thai" widget="statusbar"
                           statusbar_visible="nhap,cho_duyet,da_duyet"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_gui_duyet"
                                attrs="{'invisible': [('trang_thai', '!=', 'nhap')]}">
                            <field name="so_phep_con_lai" string="Phep con lai" widget="statinfo"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <label for="ma_don"/>
                        <h1>
                            <field name="ma_don" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Thong tin nhan vien">
                            <field name="nhan_vien_id"/>
                            <field name="phong_ban_id"/>
                            <field name="loai_nghi_phep_id"/>
                            <field name="co_luong"/>
                        </group>
                        <group string="Thoi gian nghi">
                            <field name="nghi_nua_ngay"/>
                            <field name="buoi_nghi" attrs="{'invisible': [('nghi_nua_ngay', '=', False)], 
                                                           'required': [('nghi_nua_ngay', '=', True)]}"/>
                            <field name="ngay_bat_dau"/>
                            <field name="ngay_ket_thuc" attrs="{'invisible': [('nghi_nua_ngay', '=', True)]}"/>
                            <field name="so_ngay_nghi"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="ly_do" placeholder="Nhap ly do nghi phep..."/>
                    </group>
                    
                    <group attrs="{'invisible': [('trang_thai', 'not in', ['da_duyet', 'tu_choi'])]}">
                        <group string="Thong tin duyet">
                            <field name="nguoi_duyet_id"/>
                            <field name="ngay_duyet"/>
                        </group>
                        <group attrs="{'invisible': [('trang_thai', '!=', 'tu_choi')]}">
                            <field name="ly_do_tu_choi"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="ghi_chu" placeholder="Ghi chu them..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <record id="view_don_nghi_phep_tree" model="ir.ui.view">
        <field name="name">don_nghi_phep.tree</field>
        <field name="model">don_nghi_phep</field>
        <field name="arch" type="xml">
            <tree string="Don nghi phep"
                  decoration-info="trang_thai=='nhap'"
                  decoration-warning="trang_thai=='cho_duyet'"
                  decoration-success="trang_thai=='da_duyet'"
                  decoration-danger="trang_thai in ['tu_choi', 'huy']">
                <field name="ma_don"/>
                <field name="nhan_vien_id"/>
                <field name="phong_ban_id"/>
                <field name="loai_nghi_phep_id"/>
                <field name="ngay_bat_dau"/>
                <field name="ngay_ket_thuc"/>
                <field name="so_ngay_nghi"/>
                <field name="co_luong"/>
                <field name="trang_thai" widget="badge"
                       decoration-info="trang_thai=='nhap'"
                       decoration-warning="trang_thai=='cho_duyet'"
                       decoration-success="trang_thai=='da_duyet'"
                       decoration-danger="trang_thai in ['tu_choi', 'huy']"/>
            </tree>
        </field>
    </record>
    
    <record id="view_don_nghi_phep_search" model="ir.ui.view">
        <field name="name">don_nghi_phep.search</field>
        <field name="model">don_nghi_phep</field>
        <field name="arch" type="xml">
            <search string="Tim kiem don nghi phep">
                <field name="ma_don"/>
                <field name="nhan_vien_id"/>
                <field name="loai_nghi_phep_id"/>
                <separator/>
                <filter string="Cua toi" name="cua_toi" 
                        domain="[('nhan_vien_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Nhap" name="nhap" domain="[('trang_thai', '=', 'nhap')]"/>
                <filter string="Cho duyet" name="cho_duyet" domain="[('trang_thai', '=', 'cho_duyet')]"/>
                <filter string="Da duyet" name="da_duyet" domain="[('trang_thai', '=', 'da_duyet')]"/>
                <filter string="Tu choi" name="tu_choi" domain="[('trang_thai', '=', 'tu_choi')]"/>
                <separator/>
                <filter string="Thang nay" name="thang_nay"
                        domain="[('ngay_bat_dau', '>=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('ngay_bat_dau', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Nhan vien" name="group_nhan_vien" context="{'group_by': 'nhan_vien_id'}"/>
                    <filter string="Phong ban" name="group_phong_ban" context="{'group_by': 'phong_ban_id'}"/>
                    <filter string="Loai phep" name="group_loai_phep" context="{'group_by': 'loai_nghi_phep_id'}"/>
                    <filter string="Trang thai" name="group_trang_thai" context="{'group_by': 'trang_thai'}"/>
                    <filter string="Thang" name="group_thang" context="{'group_by': 'ngay_bat_dau:month'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <record id="view_don_nghi_phep_calendar" model="ir.ui.view">
        <field name="name">don_nghi_phep.calendar</field>
        <field name="model">don_nghi_phep</field>
        <field name="arch" type="xml">
            <calendar string="Lich nghi phep" date_start="ngay_bat_dau" date_stop="ngay_ket_thuc"
                      color="loai_nghi_phep_id" mode="month">
                <field name="nhan_vien_id"/>
                <field name="loai_nghi_phep_id"/>
                <field name="so_ngay_nghi"/>
            </calendar>
        </field>
    </record>
    
    <record id="action_don_nghi_phep" model="ir.actions.act_window">
        <field name="name">Don nghi phep</field>
        <field name="res_model">don_nghi_phep</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="context">{'search_default_cua_toi': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tao don nghi phep moi
            </p>
        </field>
    </record>
    
    <record id="action_don_nghi_phep_cho_duyet" model="ir.actions.act_window">
        <field name="name">Cho duyet</field>
        <field name="res_model">don_nghi_phep</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('trang_thai', '=', 'cho_duyet')]</field>
    </record>
    
    <!-- ==================== WIZARD TỪ CHỐI ==================== -->
    
    <record id="view_wizard_tu_choi_don_nghi_phep_form" model="ir.ui.view">
        <field name="name">wizard.tu_choi_don_nghi_phep.form</field>
        <field name="model">wizard.tu_choi_don_nghi_phep</field>
        <field name="arch" type="xml">
            <form string="Tu choi don nghi phep">
                <group>
                    <field name="don_nghi_phep_id" invisible="1"/>
                    <field name="ly_do" placeholder="Nhap ly do tu choi..."/>
                </group>
                <footer>
                    <button name="action_tu_choi" type="object" string="Xac nhan tu choi" class="btn-danger"/>
                    <button string="Huy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>
