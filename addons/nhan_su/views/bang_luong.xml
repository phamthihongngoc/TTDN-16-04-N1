<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_bang_luong_tree" model="ir.ui.view">
        <field name="name">bang_luong.tree</field>
        <field name="model">bang_luong</field>
        <field name="arch" type="xml">
            <tree string="Bang luong"
                  decoration-info="trang_thai=='chua_duyet'" 
                  decoration-success="trang_thai=='da_duyet'"
                  decoration-muted="trang_thai=='da_thanh_toan'"
                  create="false">
                <header>
                    <button name="action_tao_bang_luong_thang_nay" string="Tao bang luong thang nay" 
                            type="object" class="btn-primary"/>
                </header>
                <field name="nhan_vien_id"/>
                <field name="thang"/>
                <field name="nam"/>
                <field name="so_cong_thuc_te" string="So cong"/>
                <field name="luong_theo_cong" widget="monetary" optional="hide"/>
                <field name="luong_tang_ca" widget="monetary" optional="hide"/>
                <field name="tong_phu_cap" widget="monetary" optional="show" sum="Tong phu cap"/>
                <field name="khau_tru_bhxh" widget="monetary" optional="show" sum="Tong BHXH"/>
                <field name="thue_tncn" widget="monetary" optional="hide" sum="Tong thue TNCN"/>
                <field name="thuong" widget="monetary" sum="Tong thuong" optional="hide"/>
                <field name="phat" widget="monetary" sum="Tong phat" optional="hide"/>
                <field name="luong_nhan" widget="monetary" sum="Tong luong" decoration-bf="1" decoration-info="1"/>
                <field name="trang_thai"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bang_luong_form" model="ir.ui.view">
        <field name="name">bang_luong.form</field>
        <field name="model">bang_luong</field>
        <field name="arch" type="xml">
            <form string="Bang luong">
                <header>
                    <button name="action_tinh_lai_luong" string="Tinh lai" type="object" 
                            class="btn-secondary"/>
                    <button name="action_duyet" string="Duyet" type="object" 
                            class="oe_highlight"/>
                    <button name="action_thanh_toan" string="Thanh toan" type="object" 
                            class="oe_highlight"/>
                    <field name="trang_thai" widget="statusbar" 
                           statusbar_visible="chua_duyet,da_duyet,da_thanh_toan"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1 class="d-flex">
                            <field name="nhan_vien_id" placeholder="Chon nhan vien..." 
                                   required="1" options="{'no_create': True}" class="oe_inline"/>
                        </h1>
                        <h3 class="text-muted">
                            Thang <field name="thang" required="1" class="oe_inline" style="width: 80px;"/>
                            / <field name="nam" required="1" class="oe_inline" style="width: 100px;"/>
                        </h3>
                    </div>
                    
                    <notebook>
                        <page string="Thong tin chung" name="general">
                            <group>
                                <group string="Thong Tin Cong">
                                    <field name="so_cong_thuc_te" string="So cong thuc te"
                                           readonly="1" class="text-primary font-weight-bold"/>
                                    <field name="so_cong_chuan" string="So cong chuan"
                                           readonly="1" class="text-muted"/>
                                    <field name="so_lan_di_tre" readonly="1"/>
                                    <field name="so_lan_ve_som" readonly="1"/>
                                </group>
                                
                                <group string="Luong Co Ban">
                                    <field name="luong_co_ban" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="luong_theo_cong" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="luong_tang_ca" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            
                            <group>
                                <group string="Thuong / Phat">
                                    <field name="thuong" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="phat" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" 
                                           help="Phat khac"/>
                                    <field name="phat_di_tre_ve_som" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                                
                                <group string="Tong Luong">
                                    <field name="luong_nhan" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           class="text-success font-weight-bold"
                                           style="font-size: 24px;"/>
                                </group>
                            </group>
                            
                            <group>
                                <field name="ghi_chu" placeholder="Ghi chu ve bang luong..."/>
                            </group>
                        </page>
                        
                        <page string="Phu cap" name="phu_cap">
                            <group>
                                <group>
                                    <field name="tong_phu_cap" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           class="text-success font-weight-bold"/>
                                </group>
                            </group>
                            <field name="chi_tiet_phu_cap" readonly="1" 
                                   placeholder="Chi tiet cac khoan phu cap se hien thi o day..." nolabel="1"/>
                        </page>
                        
                        <page string="BHXH va Thue" name="bhxh_thue">
                            <group>
                                <group string="Bao Hiem Xa Hoi">
                                    <field name="luong_dong_bhxh" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="khau_tru_bhxh" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           class="text-danger"/>
                                    <field name="bhxh_doanh_nghiep" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           class="text-warning"/>
                                </group>
                                
                                <group string="Thue Thu Nhap Ca Nhan">
                                    <field name="so_nguoi_phu_thuoc"/>
                                    <field name="thu_nhap_chiu_thue" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="thue_tncn" readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           class="text-danger font-weight-bold"/>
                                </group>
                            </group>
                            
                            <div class="alert alert-info mt-3" role="alert">
                                <strong>Cong thuc tinh:</strong><br/>
                                - BHXH nguoi lao dong: BHXH 8% + BHYT 1.5% + BHTN 1% = 10.5%<br/>
                                - BHXH doanh nghiep: BHXH 17.5% + BHYT 3% + BHTN 1% = 21.5%<br/>
                                - Thu nhap chiu thue = Thu nhap - BHXH - Giam tru ban than (11 trieu) - Giam tru phu thuoc (4.4 trieu/nguoi)
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_bang_luong_pivot" model="ir.ui.view">
        <field name="name">bang_luong.pivot</field>
        <field name="model">bang_luong</field>
        <field name="arch" type="xml">
            <pivot string="Thống kê lương">
                <field name="nhan_vien_id" type="row"/>
                <field name="thang" type="col"/>
                <field name="luong_nhan" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_bang_luong_graph" model="ir.ui.view">
        <field name="name">bang_luong.graph</field>
        <field name="model">bang_luong</field>
        <field name="arch" type="xml">
            <graph string="Biểu đồ lương" type="bar">
                <field name="nhan_vien_id"/>
                <field name="luong_nhan" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bang_luong_search" model="ir.ui.view">
        <field name="name">bang_luong.search</field>
        <field name="model">bang_luong</field>
        <field name="arch" type="xml">
            <search string="Tim kiem bang luong">
                <field name="nhan_vien_id"/>
                <field name="thang"/>
                <field name="nam"/>
                
                <filter string="Thang nay" name="this_month" 
                        domain="[('thang', '=', str(context_today().month)), ('nam', '=', context_today().year)]"/>
                <filter string="Nam nay" name="this_year" 
                        domain="[('nam', '=', context_today().year)]"/>
                
                <separator/>
                <filter string="Chua duyet" name="chua_duyet" 
                        domain="[('trang_thai', '=', 'chua_duyet')]"/>
                <filter string="Da duyet" name="da_duyet" 
                        domain="[('trang_thai', '=', 'da_duyet')]"/>
                <filter string="Da thanh toan" name="da_thanh_toan" 
                        domain="[('trang_thai', '=', 'da_thanh_toan')]"/>
                
                <group expand="0" string="Nhom theo">
                    <filter string="Nhan vien" name="group_nhan_vien" 
                            context="{'group_by': 'nhan_vien_id'}"/>
                    <filter string="Thang" name="group_thang" 
                            context="{'group_by': 'thang'}"/>
                    <filter string="Nam" name="group_nam" 
                            context="{'group_by': 'nam'}"/>
                    <filter string="Trang thai" name="group_trang_thai" 
                            context="{'group_by': 'trang_thai'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bang_luong" model="ir.actions.act_window">
        <field name="name">Bảng Lương</field>
        <field name="res_model">bang_luong</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo bảng lương mới
            </p>
            <p>
                Click <b>Tạo</b> để tính lương cho nhân viên theo tháng.<br/>
                Hệ thống sẽ tự động tính toán dựa trên số công đã chấm.
            </p>
        </field>
    </record>
</odoo>
