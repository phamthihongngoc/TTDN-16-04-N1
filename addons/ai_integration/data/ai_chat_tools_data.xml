            <field name="model_name">ai.chat.tool.nhan_su</field>
            <field name="method_name">tool_search_employee</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "query": {
            "type": "string",
            "description": "Từ khóa tìm kiếm (tên, mã NV, email, SĐT)"
