            <field name="method_name">tool_extract_entities</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "model": {
            "type": "string",
            "description": "Model văn bản"
        },
        "res_id": {
            "type": "integer",
            "description": "ID văn bản"
        }
    }
}</field>
            <field name="sequence">120</field>
            <field name="icon">fa-tags</field>
            <field name="is_quick_action">True</field>
            <field name="quick_action_label">Trích xuất</field>
            <field name="quick_action_prompt">Trích xuất các thông tin quan trọng từ văn bản này</field>
            <field name="applicable_models">van_ban_den,van_ban_di,van_ban</field>
        </record>
        
        <record id="tool_classify_document" model="ai.chat.tool">
            <field name="name">classify_document</field>
            <field name="display_name">Phân loại văn bản</field>
