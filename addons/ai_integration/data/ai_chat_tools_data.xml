<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ==================== KHÁCH HÀNG TOOLS ==================== -->
        
        <record id="tool_search_customer" model="ai.chat.tool">
            <field name="name">search_customer</field>
            <field name="display_name">Tìm kiếm khách hàng</field>
            <field name="description">Tìm kiếm khách hàng theo tên, mã, email hoặc số điện thoại. Sử dụng khi user hỏi về một khách hàng cụ thể hoặc muốn tìm danh sách khách hàng.</field>
            <field name="module">khach_hang</field>
            <field name="model_name">ai.chat.tool.khach_hang</field>
            <field name="method_name">tool_search_customer</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "query": {
            "type": "string",
            "description": "Từ khóa tìm kiếm (tên, mã, email, SĐT)"
        },
        "filters": {
            "type": "object",
            "description": "Bộ lọc bổ sung",
            "properties": {
                "loai_khach_hang": {"type": "string"},
                "trang_thai": {"type": "string"}
            }
        },
        "limit": {
            "type": "integer",
            "description": "Số lượng kết quả tối đa",
            "default": 10
        }
    },
    "required": ["query"]
}</field>
            <field name="sequence">10</field>
            <field name="icon">fa-search</field>
            <field name="applicable_models">khach_hang,don_hang,ho_tro_khach_hang</field>
        </record>
        
        <record id="tool_get_customer_brief" model="ai.chat.tool">
            <field name="name">get_customer_brief</field>
            <field name="display_name">Tóm tắt khách hàng</field>
            <field name="description">Lấy thông tin tóm tắt 360° về khách hàng bao gồm: thông tin cơ bản, lịch sử đơn hàng, phiếu hỗ trợ, phân loại RFM. Dùng khi user hỏi về thông tin tổng quan của một khách hàng.</field>
            <field name="module">khach_hang</field>
            <field name="model_name">ai.chat.tool.khach_hang</field>
            <field name="method_name">tool_get_customer_brief</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "customer_id": {
            "type": "integer",
            "description": "ID khách hàng (lấy từ context nếu không có)"
        }
    }
}</field>
            <field name="sequence">20</field>
            <field name="icon">fa-user-circle</field>
            <field name="is_quick_action">True</field>
            <field name="quick_action_label">Tóm tắt KH</field>
            <field name="quick_action_prompt">Tóm tắt thông tin khách hàng này</field>
            <field name="applicable_models">khach_hang</field>
        </record>
        
        <record id="tool_summarize_interactions" model="ai.chat.tool">
            <field name="name">summarize_interactions</field>
            <field name="display_name">Tổng hợp tương tác</field>
            <field name="description">Tổng hợp lịch sử tương tác với khách hàng trong một khoảng thời gian: đơn hàng, phiếu hỗ trợ, liên hệ.</field>
            <field name="module">khach_hang</field>
            <field name="model_name">ai.chat.tool.khach_hang</field>
            <field name="method_name">tool_summarize_interactions</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "customer_id": {
            "type": "integer",
            "description": "ID khách hàng"
        },
        "days": {
            "type": "integer",
            "description": "Số ngày lịch sử cần lấy",
            "default": 30
        }
    }
}</field>
            <field name="sequence">30</field>
            <field name="icon">fa-history</field>
            <field name="applicable_models">khach_hang</field>
        </record>
        
        <record id="tool_analyze_customer_risk" model="ai.chat.tool">
            <field name="name">analyze_customer_risk</field>
            <field name="display_name">Phân tích rủi ro</field>
            <field name="description">Phân tích các yếu tố rủi ro của khách hàng: vấn đề tồn đọng, xu hướng giảm, nguy cơ rời bỏ.</field>
            <field name="module">khach_hang</field>
            <field name="model_name">ai.chat.tool.khach_hang</field>
            <field name="method_name">tool_analyze_customer_risk</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "customer_id": {
            "type": "integer",
            "description": "ID khách hàng"
        }
    }
}</field>
            <field name="sequence">40</field>
            <field name="icon">fa-exclamation-triangle</field>
            <field name="applicable_models">khach_hang</field>
        </record>
        
        <record id="tool_get_customer_orders" model="ai.chat.tool">
            <field name="name">get_customer_orders</field>
            <field name="display_name">Xem đơn hàng</field>
            <field name="description">Lấy danh sách đơn hàng của khách hàng, có thể lọc theo trạng thái.</field>
            <field name="module">khach_hang</field>
            <field name="model_name">ai.chat.tool.khach_hang</field>
            <field name="method_name">tool_get_customer_orders</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "customer_id": {
            "type": "integer",
            "description": "ID khách hàng"
        },
        "status": {
            "type": "string",
            "description": "Lọc theo trạng thái đơn hàng"
        },
        "limit": {
            "type": "integer",
            "description": "Số lượng tối đa",
            "default": 10
        }
    }
}</field>
            <field name="sequence">50</field>
            <field name="icon">fa-shopping-cart</field>
            <field name="is_quick_action">True</field>
            <field name="quick_action_label">Xem đơn hàng</field>
            <field name="quick_action_prompt">Cho tôi xem các đơn hàng của khách hàng này</field>
            <field name="applicable_models">khach_hang,don_hang</field>
        </record>
        
        <record id="tool_draft_customer_email" model="ai.chat.tool">
            <field name="name">draft_customer_email</field>
            <field name="display_name">Soạn email</field>
            <field name="description">Soạn email cho khách hàng với các mục đích: chăm sóc, nhắc nhở, khảo sát, khuyến mãi. Email được soạn tự động dựa trên thông tin khách hàng.</field>
            <field name="module">khach_hang</field>
            <field name="model_name">ai.chat.tool.khach_hang</field>
            <field name="method_name">tool_draft_customer_email</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "customer_id": {
            "type": "integer",
            "description": "ID khách hàng"
        },
        "intent": {
            "type": "string",
            "enum": ["care", "reminder", "survey", "promotion"],
            "description": "Mục đích email: care=chăm sóc, reminder=nhắc nhở, survey=khảo sát, promotion=khuyến mãi"
        },
        "tone": {
            "type": "string",
            "enum": ["formal", "friendly", "urgent"],
            "description": "Giọng văn: formal=trang trọng, friendly=thân thiện, urgent=khẩn cấp",
            "default": "friendly"
        },
        "additional_info": {
            "type": "string",
            "description": "Thông tin bổ sung cho email"
        }
    },
    "required": ["intent"]
}</field>
            <field name="sequence">60</field>
            <field name="icon">fa-envelope</field>
            <field name="is_quick_action">True</field>
            <field name="quick_action_label">Soạn email</field>
            <field name="quick_action_prompt">Soạn email chăm sóc cho khách hàng này</field>
            <field name="applicable_models">khach_hang</field>
        </record>
        
        <record id="tool_create_support_ticket" model="ai.chat.tool">
            <field name="name">create_support_ticket</field>
            <field name="display_name">Tạo phiếu hỗ trợ</field>
            <field name="description">Tạo phiếu hỗ trợ mới cho khách hàng. Cần xác nhận trước khi thực hiện.</field>
            <field name="module">khach_hang</field>
            <field name="model_name">ai.chat.tool.khach_hang</field>
            <field name="method_name">tool_create_support_ticket</field>
            <field name="is_read_only">False</field>
            <field name="requires_confirmation">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "customer_id": {
            "type": "integer",
            "description": "ID khách hàng"
        },
        "subject": {
            "type": "string",
            "description": "Tiêu đề phiếu hỗ trợ"
        },
        "description": {
            "type": "string",
            "description": "Mô tả chi tiết vấn đề"
        },
        "priority": {
            "type": "string",
            "enum": ["low", "normal", "high", "urgent"],
            "description": "Mức độ ưu tiên",
            "default": "normal"
        }
    },
    "required": ["subject", "description"]
}</field>
            <field name="sequence">70</field>
            <field name="icon">fa-ticket</field>
            <field name="applicable_models">khach_hang,ho_tro_khach_hang</field>
        </record>
        
        <record id="tool_next_best_action" model="ai.chat.tool">
            <field name="name">next_best_action</field>
            <field name="display_name">Đề xuất hành động</field>
            <field name="description">Phân tích và đề xuất bước tiếp theo nên làm với khách hàng dựa trên dữ liệu: lịch sử mua hàng, phiếu hỗ trợ, phân loại RFM.</field>
            <field name="module">khach_hang</field>
            <field name="model_name">ai.chat.tool.khach_hang</field>
            <field name="method_name">tool_next_best_action</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "customer_id": {
            "type": "integer",
            "description": "ID khách hàng"
        }
    }
}</field>
            <field name="sequence">80</field>
            <field name="icon">fa-lightbulb-o</field>
            <field name="is_quick_action">True</field>
            <field name="quick_action_label">Đề xuất</field>
            <field name="quick_action_prompt">Tôi nên làm gì tiếp với khách hàng này?</field>
            <field name="applicable_models">khach_hang</field>
        </record>
        
        <!-- ==================== VĂN BẢN TOOLS ==================== -->
        
        <record id="tool_search_document" model="ai.chat.tool">
            <field name="name">search_document</field>
            <field name="display_name">Tìm văn bản</field>
            <field name="description">Tìm kiếm văn bản theo trích yếu, số ký hiệu, nơi gửi/nhận. Có thể lọc theo loại (đến/đi) và trạng thái.</field>
            <field name="module">van_ban</field>
            <field name="model_name">ai.chat.tool.van_ban</field>
            <field name="method_name">tool_search_document</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "query": {
            "type": "string",
            "description": "Từ khóa tìm kiếm"
        },
        "doc_type": {
            "type": "string",
            "enum": ["incoming", "outgoing", "all"],
            "description": "Loại văn bản: incoming=đến, outgoing=đi"
        },
        "filters": {
            "type": "object",
            "properties": {
                "trang_thai": {"type": "string"}
            }
        },
        "limit": {
            "type": "integer",
            "default": 10
        }
    },
    "required": ["query"]
}</field>
            <field name="sequence">100</field>
            <field name="icon">fa-search</field>
            <field name="applicable_models">van_ban,van_ban_den,van_ban_di</field>
        </record>
        
        <record id="tool_summarize_document" model="ai.chat.tool">
            <field name="name">summarize_document</field>
            <field name="display_name">Tóm tắt văn bản</field>
            <field name="description">Tóm tắt nội dung văn bản: ý chính, các điểm quan trọng, deadline, yêu cầu hành động.</field>
            <field name="module">van_ban</field>
            <field name="model_name">ai.chat.tool.van_ban</field>
            <field name="method_name">tool_summarize_document</field>
            <field name="is_read_only">True</field>
            <field name="parameters_schema">{
    "type": "object",
    "properties": {
        "model": {
            "type": "string",
            "description": "Model văn bản (van_ban_den, van_ban_di)"
        },
        "res_id": {
            "type": "integer",
            "description": "ID văn bản"
        }
    }
}</field>
            <field name="sequence">110</field>
            <field name="icon">fa-file-text-o</field>
            <field name="is_quick_action">True</field>
            <field name="quick_action_label">Tóm tắt VB</field>
            <field name="quick_action_prompt">Tóm tắt nội dung văn bản này</field>
            <field name="applicable_models">van_ban_den,van_ban_di,van_ban</field>
        </record>
        
        <record id="tool_extract_entities" model="ai.chat.tool">
            <field name="name">extract_entities</field>
            <field name="display_name">Trích xuất thực thể</field>
            <field name="description">Trích xuất các thực thể từ văn bản: người, cơ quan, ngày tháng, số văn bản, thời hạn, số tiền, địa điểm, yêu cầu hành động.</field>
