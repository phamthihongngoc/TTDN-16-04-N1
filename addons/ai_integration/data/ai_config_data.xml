<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default OpenAI Configuration -->
        <record id="config_openai_model" model="ir.config_parameter">
            <field name="key">ai_integration.openai_model</field>
            <field name="value">gpt-4o-mini</field>
        </record>
        
        <record id="config_max_tokens" model="ir.config_parameter">
            <field name="key">ai_integration.max_tokens</field>
            <field name="value">2000</field>
        </record>
        
        <record id="config_temperature" model="ir.config_parameter">
            <field name="key">ai_integration.temperature</field>
            <field name="value">0.3</field>
        </record>
        
        <record id="config_timeout" model="ir.config_parameter">
            <field name="key">ai_integration.timeout</field>
            <field name="value">60</field>
        </record>
        
        <record id="config_max_retries" model="ir.config_parameter">
            <field name="key">ai_integration.max_retries</field>
            <field name="value">3</field>
        </record>
        
        <record id="config_log_enabled" model="ir.config_parameter">
            <field name="key">ai_integration.log_enabled</field>
            <field name="value">True</field>
        </record>
        
        <record id="config_cache_enabled" model="ir.config_parameter">
            <field name="key">ai_integration.cache_enabled</field>
            <field name="value">True</field>
        </record>
        
        <record id="config_cache_ttl" model="ir.config_parameter">
            <field name="key">ai_integration.cache_ttl</field>
            <field name="value">3600</field>
        </record>
        
        <record id="config_log_retention" model="ir.config_parameter">
            <field name="key">ai_integration.log_retention_days</field>
            <field name="value">90</field>
        </record>
        
        <record id="config_mask_pii" model="ir.config_parameter">
            <field name="key">ai_integration.mask_pii</field>
            <field name="value">True</field>
        </record>
        
        <!-- Cron: Process AI Jobs -->
        <record id="cron_process_ai_jobs" model="ir.cron">
            <field name="name">AI: Xử lý tác vụ AI chờ</field>
            <field name="model_id" ref="model_ai_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_pending_jobs()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron: Cleanup expired cache -->
        <record id="cron_cleanup_cache" model="ir.cron">
            <field name="name">AI: Xóa cache hết hạn</field>
            <field name="model_id" ref="model_ai_cache"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron: Cleanup old logs -->
        <record id="cron_cleanup_logs" model="ir.cron">
            <field name="name">AI: Xóa log cũ</field>
            <field name="model_id" ref="model_ai_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="active">True</field>
        </record>
        
        <!-- Auto-assign admin user to AI Manager group -->
        <function model="res.users" name="write">
            <value eval="[ref('base.user_admin')]"/>
            <value eval="{'groups_id': [(4, ref('group_ai_manager'))]}"/>
        </function>
    </data>
</odoo>
