<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_van_ban_ocr_tree" model="ir.ui.view">
        <field name="name">van_ban_ocr.tree</field>
        <field name="model">van_ban_ocr</field>
        <field name="arch" type="xml">
            <tree string="OCR" default_order="id desc" decoration-success="noi_dung_trich_xuat != False" decoration-muted="noi_dung_trich_xuat == False">
                <field name="name"/>
                <field name="ten_file"/>
                <field name="loai_file"/>
                <field name="create_date"/>
                <field name="noi_dung_trich_xuat" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_van_ban_ocr_form" model="ir.ui.view">
        <field name="name">van_ban_ocr.form</field>
        <field name="model">van_ban_ocr</field>
        <field name="arch" type="xml">
            <form string="OCR">
                <header>
                    <button name="action_trich_xuat" string="Trích xuất văn bản" type="object" 
                            class="btn btn-primary oe_highlight"
                            style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 20px; padding: 8px 20px; font-weight: 500; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);"
                            attrs="{'invisible': [('file_dinh_kem', '=', False)]}"/>
                    <button name="action_ai_summarize" string="Tóm tắt văn bản" type="object" 
                            class="btn btn-success"
                            style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); border: none; border-radius: 20px; padding: 8px 20px; font-weight: 500; box-shadow: 0 4px 15px rgba(17, 153, 142, 0.4);"
                            attrs="{'invisible': [('noi_dung_trich_xuat', '=', False)]}"/>
                    <button name="action_clear_file" string="Xóa file" type="object" 
                            class="btn btn-danger"
                            style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%); border: none; border-radius: 20px; padding: 8px 20px; font-weight: 500; box-shadow: 0 4px 15px rgba(238, 90, 90, 0.4);"
                            attrs="{'invisible': [('file_dinh_kem', '=', False)]}"/>
                </header>

                <sheet>
                    <!-- Tên OCR -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nhập tên OCR..."/>
                        </h1>
                    </div>

                    <!-- Thông tin file -->
                    <group string="Tải lên tệp tin">
                        <group>
                            <field name="file_dinh_kem" filename="ten_file"/>
                            <field name="ten_file" string="Tên file"/>
                            <field name="loai_file" string="Loại file" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Layout 2 cột ngang: Trích xuất bên trái, Tóm tắt bên phải -->
                    <div class="o_ocr_layout">
                        <!-- Cột trái: Nội dung trích xuất -->
                        <div class="o_ocr_panel">
                            <div class="o_ocr_panel_header o_ocr_panel_header--extract">
                                Nội dung trích xuất
                            </div>
                            <div class="o_ocr_panel_body o_ocr_panel_body--monospace">
                                <field name="noi_dung_trich_xuat" nolabel="1"
                                       placeholder="Nội dung trích xuất sẽ hiển thị ở đây sau khi nhấn 'Trích xuất văn bản'..."/>
                            </div>
                        </div>
                        
                        <!-- Cột phải: Tóm tắt AI -->
                        <div class="o_ocr_panel">
                            <div class="o_ocr_panel_header o_ocr_panel_header--summary">
                                Tóm tắt AI
                            </div>
                            <div class="o_ai_meta" attrs="{'invisible': [('ai_summary', '=', False)]}">
                                <div class="o_ai_meta_item">
                                    <strong>Thời gian:</strong>
                                    <field name="ai_summary_at" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                            <div class="o_ocr_panel_body">
                                <field name="ai_summary" nolabel="1" readonly="1"
                                       placeholder="Nhấn 'Tóm tắt văn bản' để AI tạo tóm tắt nội dung..."/>
                            </div>
                        </div>
                    </div>

                    <!-- Tabs phụ -->
                    <notebook>
                        <page string="Lịch sử">
                            <field name="history_ids" context="{'default_ocr_id': active_id}" nolabel="1">
                                <tree string="Lịch sử trích xuất" default_order="create_date desc">
                                    <field name="create_date"/>
                                    <field name="user_id"/>
                                    <field name="ten_file"/>
                                    <field name="loai_file"/>
                                    <field name="checksum_sha1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Lỗi" attrs="{'invisible': [('loi_xu_ly', '=', False)]}">
                            <group>
                                <field name="loi_xu_ly" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_van_ban_ocr" model="ir.actions.act_window">
        <field name="name">OCR</field>
        <field name="res_model">van_ban_ocr</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload file .docx/.png/.jpg để trích xuất nội dung.
            </p>
        </field>
    </record>

    <record id="view_van_ban_ocr_history_tree" model="ir.ui.view">
        <field name="name">van_ban_ocr_history.tree</field>
        <field name="model">van_ban_ocr_history</field>
        <field name="arch" type="xml">
            <tree string="Lịch sử OCR" default_order="create_date desc">
                <field name="create_date"/>
                <field name="ocr_id"/>
                <field name="user_id"/>
                <field name="ten_file"/>
                <field name="loai_file"/>
                <field name="checksum_sha1"/>
            </tree>
        </field>
    </record>

    <record id="view_van_ban_ocr_history_form" model="ir.ui.view">
        <field name="name">van_ban_ocr_history.form</field>
        <field name="model">van_ban_ocr_history</field>
        <field name="arch" type="xml">
            <form string="Lịch sử OCR">
                <sheet>
                    <group>
                        <field name="ocr_id" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="ten_file" readonly="1"/>
                        <field name="loai_file" readonly="1"/>
                        <field name="checksum_sha1" readonly="1"/>
                        <field name="lang" readonly="1"/>
                        <field name="tesseract_config" readonly="1"/>
                    </group>
                    <group string="File lưu trữ">
                        <field name="file_dinh_kem" filename="ten_file"/>
                    </group>
                    <notebook>
                        <page string="Nội dung">
                            <field name="noi_dung_trich_xuat"/>
                        </page>
                        <page string="Lỗi" attrs="{'invisible': [('loi_xu_ly', '=', False)]}">
                            <field name="loi_xu_ly" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_van_ban_ocr_history" model="ir.actions.act_window">
        <field name="name">Lịch sử OCR</field>
        <field name="res_model">van_ban_ocr_history</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_ocr_id': 1}</field>
    </record>

</odoo>
