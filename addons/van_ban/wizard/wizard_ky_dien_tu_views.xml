<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Form View -->
    <record id="view_wizard_ky_dien_tu_form" model="ir.ui.view">
        <field name="name">wizard.ky.dien.tu.form</field>
        <field name="model">wizard.ky.dien.tu</field>
        <field name="arch" type="xml">
            <form string="Ký điện tử">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <i class="fa fa-pencil-square-o" title="Ký điện tử"/> Ký điện tử
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Thông tin văn bản">
                            <field name="van_ban_id" invisible="1"/>
                            <field name="van_ban_di_id" invisible="1"/>
                            <field name="van_ban_den_id" invisible="1"/>
                            <field name="document_display_type" readonly="1"/>
                            <field name="document_display_name" readonly="1"/>
                            <field name="ten_van_ban" readonly="1" attrs="{'invisible': [('van_ban_id', '=', False)]}"/>
                            <field name="loai_van_ban" readonly="1" attrs="{'invisible': [('van_ban_id', '=', False)]}"/>
                        </group>
                        <group string="Người ký">
                            <!-- Ẩn ô chọn người ký (bị thừa vì đã có Họ tên/Chức vụ bên dưới) -->
                            <field name="nguoi_ky_id" options="{'no_create': True}" readonly="1" invisible="1" domain="[('ten_nv','=','Phạm Thị Hồng Ngọc')]"/>
                            <field name="pdf_ten_nguoi_ky" readonly="1"/>
                            <field name="pdf_chuc_vu" readonly="1"/>
                            <field name="ten_nguoi_ky" readonly="1" invisible="1"/>
                            <field name="chuc_vu" readonly="1" invisible="1"/>
                            <field name="ho_ten_xac_nhan" required="1" placeholder="Nhập đúng họ và tên để xác minh"/>
                        </group>
                    </group>
                    
                    <separator string="Upload ảnh chữ ký của bạn"/>
                    
                    <div class="alert alert-info" role="alert">
                        <p><i class="fa fa-info-circle" title="Thông tin"/> <strong>Hướng dẫn:</strong></p>
                        <ul>
                            <li>Upload ảnh chữ ký có sẵn của bạn (JPG/PNG)</li>
                            <li>Hệ thống sẽ tự động sinh Private Key và Public Key từ ảnh</li>
                            <li>Public Key sẽ được lưu vào kho để xác thực sau này</li>
                            <li>Chữ ký sẽ có giá trị pháp lý</li>
                        </ul>
                    </div>
                    
                    <group>
                        <field name="chu_ky" 
                               widget="image" 
                               options="{'size': [400, 200]}"
                               filename="chu_ky_filename"/>
                        <field name="chu_ky_filename" invisible="1"/>
                        <field name="keys_generated" invisible="1"/>
                        <field name="private_key_generated" invisible="1"/>
                        <field name="public_key_generated" invisible="1"/>
                        
                        <div colspan="2" class="alert alert-success" role="alert" attrs="{'invisible': [('keys_generated', '=', False)]}">
                            <p><i class="fa fa-check-circle" title="Thành công"/> <strong>✓ Private/Public Key đã được sinh tự động!</strong></p>
                            <p>Public Key sẽ được lưu vào kho khi ký thành công.</p>
                        </div>
                    </group>
                    
                    <group>
                        <field name="xac_nhan"/>
                        <label for="xac_nhan" string=""/>
                        <div class="text-muted" style="font-size: 90%;">
                            Bằng việc đánh dấu vào ô này và ký điện tử, tôi xác nhận rằng:
                            <ul>
                                <li>Đã đọc kỹ nội dung văn bản</li>
                                <li>Đồng ý với toàn bộ nội dung</li>
                                <li>Chịu trách nhiệm về chữ ký điện tử này</li>
                            </ul>
                        </div>
                    </group>

                    <group string="🔐 Xác thực 2 lớp (OTP)" col="4" attrs="{'invisible': [('require_otp', '=', False)]}">
                        <field name="require_otp" colspan="4"/>
                        <div colspan="4" class="alert alert-warning" role="alert" attrs="{'invisible': ['|', ('otp_sent', '=', True), ('otp_verified', '=', True)]}">
                            <p><i class="fa fa-shield" title="Bảo mật"/> <strong>Xác thực 2 lớp bằng OTP qua Email</strong></p>
                            <p>Để tăng cường bảo mật, bạn cần xác thực OTP trước khi ký.</p>
                        </div>
                        <field name="otp_sent" invisible="1"/>
                        <field name="otp_verified" invisible="1"/>
                        <field name="otp_sent_code" invisible="1"/>
                        <field name="otp_sent_at" invisible="1"/>
                        
                        <!-- Nút Gửi OTP - hiện khi chưa gửi -->
                        <button name="action_send_otp" 
                                string="📧 Gửi mã OTP đến Email" 
                                type="object" 
                                class="btn-warning oe_highlight"
                                colspan="4"
                                attrs="{'invisible': ['|', ('otp_sent', '=', True), ('otp_verified', '=', True)]}"/>
                        
                        <!-- Thông báo đã gửi OTP -->
                        <div colspan="4" class="alert alert-info" role="alert" attrs="{'invisible': ['|', ('otp_sent', '=', False), ('otp_verified', '=', True)]}">
                            <p><strong>✅ OTP đã được gửi đến email: <field name="user_email" readonly="1" nolabel="1" class="d-inline"/></strong></p>
                            <p>Vui lòng kiểm tra hộp thư (kể cả Spam) và nhập mã OTP 6 số bên dưới:</p>
                        </div>
                        
                        <!-- Ô nhập OTP - CHỈ hiện khi đã gửi OTP -->
                        <field name="otp_code" 
                               string="Nhập mã OTP (6 số)"
                               placeholder="Nhập 6 số từ email"
                               colspan="2"
                               class="o_field_highlight"
                               attrs="{'invisible': ['|', ('otp_sent', '=', False), ('otp_verified', '=', True)], 'required': [('otp_sent', '=', True), ('otp_verified', '=', False)]}"/>
                        
                        <!-- Nút Xác thực OTP - chỉ hiện khi đã gửi -->
                        <button name="action_verify_otp" 
                                string="✓ Xác thực OTP" 
                                type="object" 
                                class="btn-success oe_highlight"
                                colspan="2"
                                attrs="{'invisible': ['|', ('otp_sent', '=', False), ('otp_verified', '=', True)]}"/>
                        
                        <!-- Nút Gửi lại OTP -->
                        <button name="action_send_otp" 
                                string="🔄 Gửi lại OTP" 
                                type="object" 
                                class="btn-link"
                                colspan="4"
                                attrs="{'invisible': ['|', ('otp_sent', '=', False), ('otp_verified', '=', True)]}"/>
                        
                        <!-- Thông báo xác thực thành công -->
                        <div colspan="4" class="alert alert-success" role="alert" attrs="{'invisible': [('otp_verified', '=', False)]}">
                            <p><i class="fa fa-check-circle" title="Thành công"/> <strong>OTP đã được xác thực thành công!</strong></p>
                            <p>Bạn có thể tiến hành ký văn bản.</p>
                        </div>
                    </group>
                    
                    <!-- Hiện group require_otp khi tắt -->
                    <group col="2" attrs="{'invisible': [('require_otp', '=', True)]}">
                        <field name="require_otp"/>
                    </group>

                    <group string="Blockchain" col="2" attrs="{'invisible': [('van_ban_id', '=', False)]}">
                        <field name="ky_blockchain"/>
                        <field name="blockchain_tx_hash" readonly="1" attrs="{'invisible': [('blockchain_tx_hash', '=', False)]}"/>
                        <div class="text-muted" colspan="2" style="font-size: 90%;" attrs="{'invisible': [('ky_blockchain', '=', False)]}">
                            Nếu chưa cấu hình `blockchain.infura_url` và `blockchain.private_key` thì hệ thống sẽ ký nội bộ và không ghi TX hash.
                        </div>
                    </group>
                    
                </sheet>
                
                <footer>
                    <button name="action_ky" 
                            string="Xác nhận ký" 
                            type="object" 
                            class="oe_highlight btn-primary"
                            icon="fa-check"/>
                    <button string="Hủy" 
                            special="cancel" 
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wizard_ky_dien_tu" model="ir.actions.act_window">
        <field name="name">Ký điện tử</field>
        <field name="res_model">wizard.ky.dien.tu</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_van_ban"/>
    </record>

</odoo>
